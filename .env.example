# ---- Server ----
PORT=3000
# Public HTTPS address of this app (used for links and the manifest)
PUBLIC_URL=https://jobcosts.example.com
# Where the database and invoice files are stored
DATA_DIR=./data
# Random long string used to sign the card's session links
SESSION_SECRET=change-me-to-a-long-random-string

# ---- ServiceM8 add-on ----
# From your ServiceM8 developer account (Store Connect -> your add-on)
SERVICEM8_APP_SECRET=

# ---- Claude (invoice reading) ----
ANTHROPIC_API_KEY=
# claude-opus-5-5 (most accurate, default), claude-sonnet-5-5 (cheaper), claude-haiku-5-5 (cheapest)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium

# ---- Email address for invoices (one for the whole business) ----
# Free option: a normal mailbox the app checks every 2 minutes (your own domain or Gmail).
# IMAP_HOST examples: imap.gmail.com (Gmail / Google Workspace, use an app password),
# imap.zoho.com, or mail.yourdomain.com.au (most web hosts).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Optional: the address suppliers send to, if different from IMAP_USER
INVOICE_EMAIL=

# Or use Postmark (paid above its free limit) instead of a mailbox:
# Option A (no domain needed): your Postmark inbound address. The business gets
#   <your-hash>+<code>@inbound.postmarkapp.com
INBOUND_BASE_ADDRESS=
# Option B: your own domain pointed at an inbound email provider. The business gets
#   invoices-<code>@<INBOUND_DOMAIN>
INBOUND_DOMAIN=
# Secret added to the webhook URL: https://.../inbound/email?key=<INBOUND_SECRET>
INBOUND_SECRET=change-me-too

# ---- Stock order jobs ----
# Jobs opened for stock orders: invoices for them go into stock instead of being a cost.
# A job is a stock order job if its client or category name contains one of these (comma separated).
STOCK_JOB_CLIENTS=Door Image
STOCK_JOB_CATEGORIES=Internal

# ---- Local testing only ----
# true = enables /dev/job/<any-id> so you can try the card without ServiceM8
DEV_MODE=false

# Outlook (Microsoft 365): read the business inbox (read-only). See README "Outlook".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
